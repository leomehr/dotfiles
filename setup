#!/bin/zsh
set -eu

dotfiles_dir="${0:A:h}"
timestamp="$(date +%Y%m%d-%H%M%S)"
install_tools=false
authenticate_github=false
github_user="${DOTFILES_GITHUB_USER:-leomehr}"

for argument in "$@"; do
  case "$argument" in
    --install) install_tools=true ;;
    --github) authenticate_github=true ;;
    *)
      print -u2 "Usage: ./setup [--install] [--github]"
      exit 2
      ;;
  esac
done

mkdir -p "$HOME/code"

if [[ "$dotfiles_dir" != "$HOME/code/dotfiles" ]]; then
  print -u2 "Note: the canonical location for this repository is $HOME/code/dotfiles"
fi

link_file() {
  local source_file="$1"
  local target="$2"

  mkdir -p "${target:h}"

  if [[ -L "$target" && "${target:A}" == "${source_file:A}" ]]; then
    print "Already linked $target -> $source_file"
    return
  fi

  if [[ -e "$target" || -L "$target" ]]; then
    local backup="${target}.backup-${timestamp}"
    mv "$target" "$backup"
    print "Moved existing $target to $backup"
  fi

  ln -s "$source_file" "$target"
  print "Linked $target -> $source_file"
}

for filename in .zshrc .aliases .gitconfig .vimrc; do
  link_file "$dotfiles_dir/$filename" "$HOME/$filename"
done

link_file \
  "$dotfiles_dir/iterm-profile.json" \
  "$HOME/Library/Application Support/iTerm2/DynamicProfiles/dotfiles.json"
link_file "$dotfiles_dir/agent-instructions.md" "$HOME/.codex/AGENTS.md"
link_file "$dotfiles_dir/agent-instructions.md" "$HOME/.claude/CLAUDE.md"

if $install_tools; then
  if ! (( $+commands[brew] )); then
    print -u2 "Homebrew is required for --install: https://brew.sh"
    exit 1
  fi
  brew bundle --file "$dotfiles_dir/Brewfile"
fi

if [[ "${DOTFILES_SKIP_DEFAULTS:-false}" != "true" ]] && \
  [[ -d /Applications/iTerm.app || -d "$HOME/Applications/iTerm.app" ]]; then
  defaults write com.googlecode.iterm2 LoadPrefsFromCustomFolder -bool false
fi

# Keep the Dock empty of pinned applications. Finder, Trash, folders, and
# currently running applications are unaffected.
if [[ "${DOTFILES_SKIP_DEFAULTS:-false}" != "true" ]]; then
  defaults write com.apple.dock persistent-apps -array
  killall Dock 2>/dev/null || true
fi

if $authenticate_github; then
  if ! (( $+commands[gh] )); then
    print -u2 "GitHub CLI is required for --github; rerun with --install."
    exit 1
  fi

  if ! gh auth status --hostname github.com >/dev/null 2>&1; then
    print "Opening GitHub's browser sign-in for $github_user..."
    GH_PROMPT_DISABLED=1 gh auth login \
      --hostname github.com \
      --git-protocol https \
      --web \
      --clipboard
  fi

  authenticated_user="$(gh api user --jq .login)"
  if [[ "$authenticated_user" != "$github_user" ]]; then
    print -u2 "Expected GitHub user $github_user, but the active user is $authenticated_user."
    print -u2 "Run: gh auth switch --hostname github.com --user $github_user"
    exit 1
  fi

  GIT_CONFIG_GLOBAL="$HOME/.gitconfig.local" \
    gh auth setup-git --hostname github.com
  print "GitHub CLI and Git are authenticated as $authenticated_user."
fi

if [[ -d /Applications/MacParakeet.app || \
      -d "$HOME/Applications/MacParakeet.app" ]]; then
  print "MacParakeet: open it once to grant Microphone and Accessibility access"
  print "and download the local speech model. Telemetry can be disabled in Settings."
fi

print "Open a new terminal, or run: exec zsh"
